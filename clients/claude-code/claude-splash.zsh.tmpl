# claude-splash / opencode-splash / pi-splash: coding agents on the Mac Studio's
# Splash server, using whichever model Splash has loaded. Sourced from ~/.zshrc.
# All three take the same leading arguments as claude-splash below.
#
#   claude-splash [args...]                 use the loaded model
#   claude-splash 3.6|3.8 [args...]         require that model; error if another is loaded
#   claude-splash --switch 3.6|3.8 [args]   restart Splash on the Studio with that model
#                                           (asks first: it drops every Splash client)
#
# Splash serves ONE model at a time, so every model setting (main, Opus/Sonnet/
# Haiku defaults, subagents) is pointed at the same model, via a per-run copy of
# ~/.claude/splash-settings.json. MCP servers and claude.ai connectors are left
# out: they add ~60K prompt tokens and ~2 minutes to each session's first reply.
# Splash is started with --max-cache-disk 40G (SSD tier for evicted prompt caches).

typeset -gA _SPLASH_MODELS=(
  3.6 incoai/Qwen3.6-35B-A3B-Splash
  3.8 incoai/Qwen3.8-27B-Splash
)
_SPLASH_URL=http://__SERVER_IP__:8000
_SPLASH_STUDIO=~/.claude/skills/__SERVER_NAME__/scripts/studio.sh

_splash_loaded() {
  curl -s -m 5 "$_SPLASH_URL/v1/models" 2>/dev/null |
    python3 -c 'import json,sys; print(json.load(sys.stdin)["data"][0]["id"])' 2>/dev/null
}

_splash_resolve() {  # 3.6 | 36 | full id -> full id
  local key=${1//[^0-9.]/}
  [[ $key == 36 ]] && key=3.6
  [[ $key == 38 ]] && key=3.8
  if [[ -n ${_SPLASH_MODELS[$key]} ]]; then print -r -- ${_SPLASH_MODELS[$key]}
  elif [[ $1 == incoai/* ]]; then print -r -- $1
  else return 1; fi
}

_splash_switch() {
  local want=$1 now
  now=$(_splash_loaded)
  if [[ $now == $want ]]; then
    print "claude-splash: $want is already loaded"
    return 0
  fi
  print "claude-splash: Splash has ${now:-nothing (server down)} loaded."
  print "Switching to $want restarts Splash on the Studio. It takes about a minute, and"
  print "every Splash client drops meanwhile: dsh sessions, OpenViking, other claude-splash sessions."
  read -q "?Switch now? [y/N] " || { print; return 1; }
  print
  bash $_SPLASH_STUDIO run "pkill -f 'splash serve|libexec/server/server.py'; sleep 3; nohup splash serve --host __SERVER_IP__ --port 8000 --model $want --max-cache-disk 40G > ~/splash.log 2>&1 &" ||
    { print "claude-splash: could not reach the Studio" >&2; return 1; }
  local i
  for i in {1..60}; do
    sleep 5
    [[ $(_splash_loaded) == $want ]] && { print "claude-splash: $want loaded"; return 0; }
    print -n .
  done
  print "\nclaude-splash: $want still not listed after 5 minutes; check ~/splash.log on the Studio" >&2
  return 1
}

# _splash_pick NAME ARGS... — parse [--switch] [3.6|3.8], switch if asked, and
# set REPLY to the loaded model id; sets _SPLASH_SHIFT to how many args it used.
_splash_pick() {
  local name=$1; shift
  local switch=0 want=
  _SPLASH_SHIFT=0
  if [[ $1 == --switch ]]; then
    switch=1
    want=$(_splash_resolve "$2") || { print "usage: $name --switch 3.6|3.8 [args]" >&2; return 2; }
    _SPLASH_SHIFT=2
  elif [[ $1 != -* ]] && want=$(_splash_resolve "$1" 2>/dev/null); then
    _SPLASH_SHIFT=1
  else
    want=
  fi
  if (( switch )); then _splash_switch $want || return 1; fi
  REPLY=$(_splash_loaded)
  if [[ -z $REPLY ]]; then
    print "$name: Splash isn't answering at $_SPLASH_URL (start it with: $name --switch 3.8)" >&2
    return 1
  fi
  if [[ -n $want && $want != $REPLY ]]; then
    print "$name: $want requested, but Splash has $REPLY loaded." >&2
    print "Use '$name --switch ${(k)_SPLASH_MODELS[(r)$want]:-<3.6|3.8>}' to swap, or '$name' to use $REPLY." >&2
    return 1
  fi
  print -u2 "$name: $REPLY"
}

# Qwen3.6 profile: applied when the 35B-A3B is loaded. SPLASH_PROFILE=off skips it
# (for A/B runs); SPLASH_PROFILE=force applies it to any model. The 35B is fast but
# weaker at long agentic tasks, so the profile adds:
#   - splash-proxy.py in front of Splash: preserve_thinking + Qwen coding sampling
#   - hooks: lint/syntax check after every edit; opt-in test gate on Stop
#   - qwen36-discipline.md appended to the system prompt (plan, verify, loop guard)
#   - more output room, earlier compaction, shorter tool output
_SPLASH_DIR=${0:A:h}

claude-splash() {
  _splash_pick claude-splash "$@" || return; shift $_SPLASH_SHIFT
  local model=$REPLY settings=${TMPDIR:-/tmp}/claude-splash-settings.$$.json
  local profile=0 proxy_pid= base=$_SPLASH_URL
  local -a extra_env extra_args
  if [[ ( $model == *Qwen3.6* && ${SPLASH_PROFILE:-on} != off ) || ${SPLASH_PROFILE:-} == force ]]; then
    profile=1
    local port=$(python3 -c 'import socket; s=socket.socket(); s.bind(("127.0.0.1",0)); print(s.getsockname()[1])')
    python3 $_SPLASH_DIR/splash-proxy.py $_SPLASH_URL $port &>/dev/null &!
    proxy_pid=$!
    local i; for i in {1..50}; do curl -s -m 1 -o /dev/null http://127.0.0.1:$port/v1/models && break; sleep 0.1; done
    base=http://127.0.0.1:$port
    extra_env=(CLAUDE_CODE_MAX_OUTPUT_TOKENS=32768 CLAUDE_CODE_AUTOCOMPACT_PCT_OVERRIDE=60 BASH_MAX_OUTPUT_LENGTH=15000)
    extra_args=(--append-system-prompt-file $_SPLASH_DIR/qwen36-discipline.md)
    print -u2 "claude-splash: Qwen3.6 profile on (proxy :$port, edit checks, verify gate, discipline prompt)"
  fi
  python3 - "$model" "$settings" "$base" "$profile" "$_SPLASH_DIR" <<'EOF' || { [[ -n $proxy_pid ]] && kill $proxy_pid; return 1; }
import json, os, sys
model, out, base, profile, d_ = sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4] == "1", sys.argv[5]
d = json.load(open(os.path.expanduser('~/.claude/splash-settings.json')))
for k in ('ANTHROPIC_MODEL', 'ANTHROPIC_DEFAULT_OPUS_MODEL', 'ANTHROPIC_DEFAULT_SONNET_MODEL',
          'ANTHROPIC_DEFAULT_HAIKU_MODEL', 'CLAUDE_CODE_SUBAGENT_MODEL'):
    d['env'][k] = model
d['env']['ANTHROPIC_BASE_URL'] = base
d['model'] = model
if profile:
    d['hooks'] = {
        'PostToolUse': [{'matcher': 'Edit|Write|MultiEdit',
                         'hooks': [{'type': 'command', 'command': f'{d_}/hooks/check-edit.sh', 'timeout': 60}]}],
        'Stop': [{'hooks': [{'type': 'command', 'command': f'{d_}/hooks/verify-on-stop.sh', 'timeout': 600}]}],
    }
fd = os.open(out, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
with os.fdopen(fd, 'w') as f:
    json.dump(d, f)
EOF
  # Cache-friendly prompt: with the per-session system-prompt sections excluded,
  # a new session reuses Splash's prefix cache (~25 s -> ~4 s to first token).
  env ENABLE_CLAUDEAI_MCP_SERVERS=false CLAUDE_CODE_ATTRIBUTION_HEADER=0 \
    CLAUDE_CODE_DISABLE_GIT_INSTRUCTIONS=1 CLAUDE_CODE_DISABLE_EXPERIMENTAL_BETAS=1 $extra_env \
    claude --settings "$settings" --exclude-dynamic-system-prompt-sections \
    --strict-mcp-config --mcp-config '{"mcpServers":{}}' $extra_args "$@"
  local rc=$?
  rm -f "$settings"
  [[ -n $proxy_pid ]] && kill $proxy_pid 2>/dev/null
  return $rc
}

# OpenCode on Splash, from its own lean config (~/.config/opencode-splash):
# Splash only, no plugins (oh-my-openagent sent 80K tokens / 46 tools), no skill
# or webfetch tools. ~10K-token prompt, cached across sessions (~6 s replies).
# Sessions and auth stay shared with normal opencode (~/.local/share/opencode).
opencode-splash() {
  _splash_pick opencode-splash "$@" || return; shift $_SPLASH_SHIFT
  XDG_CONFIG_HOME=$HOME/.config/opencode-splash opencode -m "splash/$REPLY" "$@"
}

# Pi on Splash (provider "splash" in ~/.pi/agent/models.json): 4 tools, ~14K prompt.
pi-splash() {
  _splash_pick pi-splash "$@" || return; shift $_SPLASH_SHIFT
  pi --model "splash/$REPLY" "$@"
}
