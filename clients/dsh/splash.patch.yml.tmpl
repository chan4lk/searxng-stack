# Overlay: point dsh at the Splash settings file instead of ~/.dsh/settings.yaml,
# register the launch directory as a web-UI workspace, route web_search
# through a local keyless SearXNG instead of DeepSeek's paid search API, and
# add image tools backed by image-server, and block agents from stopping
# anything on the server.
# Use: dsh --profile <name> --patch ~/.dsh/splash.patch.yml
- id: settings
  config:
    path: !!js dshHomePath('splash.settings.yaml')
# Splash inference server (incoai/Qwen3.8-27B-Splash) reached as a
# hand-declared pi-ai route over its OpenAI-compatible /v1 API.
# dsh >= 0.2 reads providers from this entry only, not from the settings file.
- id: llm-pi-ai
  config:
    providers:
      splash:
        displayName: Splash
        api: openai-completions
        baseURL: http://__SERVER_IP__:8000/v1
        # Server takes no auth; dsh-splash exports a placeholder value.
        apiKeyEnv: SPLASH_API_KEY
        # Measured ~120 tok/s output; generous idle window for long reasoning.
        streamIdleTimeoutMs: 300000
        defaultContextWindow: 131072
        defaultMaxTokens: 16384
        compat:
          # Verified: server accepts the developer role and max_tokens.
          supportsDeveloperRole: true
          maxTokensField: max_tokens
        models:
          - id: incoai/Qwen3.8-27B-Splash
            name: Qwen3.8 27B Splash
            # Server reports a 262144-token cache capacity; 131072 stays well
            # inside it. Raise if the server's max_model_len allows.
            contextWindow: 131072
            maxTokens: 16384
            # Always emits reasoning_content; no selectable effort levels.
            # Splash serves ONE model at a time: the unloaded one answers
            # HTTP 404 model_not_found. Switch by restarting `splash serve --model`
            # on the Studio, then pick the matching model here.
          - id: incoai/Qwen3.6-35B-A3B-Splash
            name: Qwen3.6 35B-A3B Splash (MoE)
            # Verified: answers questions about images (OpenAI image_url parts).
            # Lets read_image and generate_image show images to this model.
            input: [text, image]
            contextWindow: 131072
            maxTokens: 16384
            # Also emits reasoning_content, and reasons at length: keep maxTokens
            # generous or replies can end mid-thought (finish_reason: length).

      # sushi on the Studio (Qwen3.8-Flash-Next-Sushi-3bpw, 4-bit KV, 256K context),
      # started by ~/sushi-serve.sh there. Requires its API key: dsh-splash exports
      # SUSHI_API_KEY from ~/.sushi-api-key.
      sushi:
        displayName: Sushi
        api: openai-completions
        baseURL: http://__SERVER_IP__:8084/v1
        apiKeyEnv: SUSHI_API_KEY
        streamIdleTimeoutMs: 300000
        defaultContextWindow: 262144
        defaultMaxTokens: 32000
        compat:
          supportsDeveloperRole: true
          maxTokensField: max_tokens
        models:
          - id: Qwen3.8-Flash-Next-Sushi-3bpw
            name: Qwen3.8 Flash-Next Sushi 3bpw
            # Reads images: ~/sushi-serve.sh passes --vision (tower +0.9 GB in the SSD budget).
            # Verified 2026-10-10: answers questions about images (OpenAI image_url parts).
            input: [ text, image ]
            contextWindow: 262144
            maxTokens: 32000

      # llama-swap on the Studio (llama-swap/config.yaml): one endpoint for the llama.cpp and mlx_lm models. Picking a
      # model starts it there (first reply waits ~5-25 s); idle ones unload after 30 min or when another needs the RAM.
      # Same key as Sushi.
      studio:
        displayName: Studio (llama-swap)
        api: openai-completions
        baseURL: http://__SERVER_IP__:8100/v1
        apiKeyEnv: SUSHI_API_KEY
        streamIdleTimeoutMs: 300000
        defaultContextWindow: 131072
        defaultMaxTokens: 32768
        compat:
          supportsDeveloperRole: true
          maxTokensField: max_tokens
        models:
          # DavidAU's uncensored dense 27B merge (Apache-2.0), MTP; ~37 tok/s.
          - id: Qwen3.8-27B-FCF
            name: Qwen3.8 27B FCF (uncensored)
            input: [ text, image ]
            contextWindow: 131072
            maxTokens: 32768
          # ccore's early-preview 4B for coding and Three.js scenes (Apache-2.0); reasons long before writing code.
          - id: Qwen3.5-4B-3D-Coder
            name: Qwen3.5 4B 3D Coder
            input: [ text, image ]
            contextWindow: 65536
            maxTokens: 32768
          # Liquid AI, LFM Open License v1.0 (check before business use).
          - id: LFM2.5-24B-A2B
            name: LFM2.5 24B-A2B
            contextWindow: 131072
            maxTokens: 32768
          # JetBrains, Apache-2.0; thinks before answering.
          - id: Mellum2.1-12B-A2.5B
            name: Mellum 2.1 12B-A2.5B Thinking
            contextWindow: 131072
            maxTokens: 32768

      # Ornith-1.5-35B-A3B (MIT; Qwen3.6-35B-A3B fine-tune for coding and agents) served by Splash on the
      # Studio (~/ornith-serve.sh there; official GGUF Q4_K_M + mmproj). Same key as Sushi.
      ornith:
        displayName: Ornith
        api: openai-completions
        baseURL: http://__SERVER_IP__:8086/v1
        apiKeyEnv: SUSHI_API_KEY
        streamIdleTimeoutMs: 300000
        defaultContextWindow: 262144
        defaultMaxTokens: 32000
        compat:
          supportsDeveloperRole: true
          maxTokensField: max_tokens
        models:
          - id: Ornith-1.5-35B-A3B
            name: Ornith 1.5 35B-A3B
            input: [ text, image ]
            contextWindow: 262144
            maxTokens: 32000

      # vLLM (vllm-metal) on the Studio: Qwen3.5-9B heretic (default) or Qwen3.6-35B-A3B, one at a time; continuous batching for many
      # users (~/vllm-serve.sh there). Context is VLLM_CTX (128K). Same key as Sushi.
      vllm:
        displayName: vLLM
        api: openai-completions
        baseURL: http://__SERVER_IP__:8088/v1
        apiKeyEnv: SUSHI_API_KEY
        streamIdleTimeoutMs: 300000
        defaultContextWindow: 131072
        defaultMaxTokens: 16384
        compat:
          supportsDeveloperRole: true
          maxTokensField: max_tokens
        models:
          - id: Qwen3.5-9B-heretic
            name: Qwen3.5 9B heretic (vLLM)
            input: [ text ]
            contextWindow: 131072
            maxTokens: 16384
          # only the one vLLM serves answers (studio-stack.sh model vllm; the Studio pane's model switch)
          - id: Qwen3.6-35B-A3B
            name: Qwen3.6 35B-A3B (vLLM)
            input: [ text, image ]
            contextWindow: 131072
            maxTokens: 16384
# dsh >= 0.2 reads the default model from this entry, not from the settings file.
- id: agent-default-model
  config:
    provider: ornith
    model: Ornith-1.5-35B-A3B
- insert:
    - id: cwd-workspace
      name: __HOME__/.dsh/plugins/cwd-workspace.mjs
    - id: searxng-search
      name: __HOME__/.dsh/plugins/searxng-search.mjs
      config:
        url: http://__SERVER_NAME__.__TAILNET__:8889
    - id: image-generate
      name: __HOME__/.dsh/plugins/image-generate.mjs
      config:
        url: http://__SERVER_NAME__.__TAILNET__:8890
    - id: music-generate
      name: __HOME__/.dsh/plugins/music-generate.mjs
      config:
        url: http://__SERVER_NAME__.__TAILNET__:8891
    - id: ocr-document
      name: __HOME__/.dsh/plugins/ocr-document.mjs
      config:
        url: http://__SERVER_NAME__.__TAILNET__:8893
    # Denies agent commands that stop/kill/restart anything on the server.
    - id: studio-guard
      name: __HOME__/.dsh/plugins/studio-guard.mjs
      config:
        hosts: [__SERVER_IP__, __SERVER_NAME__, __SERVER_NAME__.__TAILNET__]
- id: web
  config:
    searchProvider: searxng
    fetchProvider: http
- id: tool-web
  config:
    fetch: true
    searchTimeoutMs: 60000
