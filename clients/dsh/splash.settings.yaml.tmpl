ui-onboarding:
  welcomeNoticeVersion: 2026-08-13.1

# Splash inference server (incoai/Qwen3.8-27B-Splash) reached as a
# hand-declared pi-ai route over its OpenAI-compatible /v1 API.
llm-pi-ai:
  providers:
    splash:
      displayName: Splash
      api: openai-completions
      baseURL: http://__SERVER_IP__:8000/v1
      # Server takes no auth; dsh-splash exports a placeholder value.
      apiKeyEnv: SPLASH_API_KEY
      # Measured ~120 tok/s output; generous idle window for long reasoning.
      streamIdleTimeoutMs: 300000
      defaultContextWindow: 131072
      defaultMaxTokens: 16384
      compat:
        # Verified: server accepts the developer role and max_tokens.
        supportsDeveloperRole: true
        maxTokensField: max_tokens
      models:
        - id: incoai/Qwen3.8-27B-Splash
          name: Qwen3.8 27B Splash
          # Server reports a 262144-token cache capacity; 131072 stays well
          # inside it. Raise if the server's max_model_len allows.
          contextWindow: 131072
          maxTokens: 16384
          # Always emits reasoning_content; no selectable effort levels.
          # Splash serves ONE model at a time: the unloaded one answers
          # HTTP 404 model_not_found. Switch by restarting `splash serve --model`
          # on the Studio, then pick the matching model here.
        - id: incoai/Qwen3.6-35B-A3B-Splash
          name: Qwen3.6 35B-A3B Splash (MoE)
          # Verified: answers questions about images (OpenAI image_url parts).
          # Lets read_image and generate_image show images to this model.
          input: [text, image]
          contextWindow: 131072
          maxTokens: 16384
          # Also emits reasoning_content, and reasons at length: keep maxTokens
          # generous or replies can end mid-thought (finish_reason: length).

    # sushi on the Studio (Qwen3.8-Flash-Next-Sushi-3bpw, 4-bit KV, 256K context),
    # started by ~/sushi-serve.sh there. Requires its API key: dsh-splash exports
    # SUSHI_API_KEY from ~/.sushi-api-key.
    sushi:
      displayName: Sushi
      api: openai-completions
      baseURL: http://__SERVER_IP__:8084/v1
      apiKeyEnv: SUSHI_API_KEY
      streamIdleTimeoutMs: 300000
      defaultContextWindow: 262144
      defaultMaxTokens: 32000
      compat:
        supportsDeveloperRole: true
        maxTokensField: max_tokens
      models:
        - id: Qwen3.8-Flash-Next-Sushi-3bpw
          name: Qwen3.8 Flash-Next Sushi 3bpw
          # Reads images: ~/sushi-serve.sh passes --vision (tower +0.9 GB in the SSD budget).
          # Verified 2026-10-10: answers questions about images (OpenAI image_url parts).
          input: [ text, image ]
          contextWindow: 262144
          maxTokens: 32000

    # Mellum2.1-12B-A2.5B-Thinking (JetBrains, Apache-2.0) on the Studio: MXFP4 MLX quant served by
    # mlx_lm.server 0.32 (~/mellum-serve.sh there). Sushi and Splash can't load the mellum architecture.
    # Server takes no auth; dsh-splash exports a placeholder value.
    mellum:
      displayName: Mellum
      api: openai-completions
      baseURL: http://__SERVER_IP__:8085/v1
      apiKeyEnv: SPLASH_API_KEY
      streamIdleTimeoutMs: 300000
      defaultContextWindow: 131072
      defaultMaxTokens: 32768
      compat:
        supportsDeveloperRole: true
        maxTokensField: max_tokens
      models:
        - id: randmaru/Mellum2.1-12B-A2.5B-Thinking-mlx-mxfp4
          name: Mellum 2.1 12B-A2.5B Thinking
          # Text only. Thinks before answering; JetBrains' sampling (temp 0.6, top_p 0.95,
          # top_k 20) is the server default.
          contextWindow: 131072
          maxTokens: 32768

    # Ornith-1.5-35B-A3B (MIT; Qwen3.6-35B-A3B fine-tune for coding and agents) served by Splash on the
    # Studio (~/ornith-serve.sh there; official GGUF Q4_K_M + mmproj). Same key as Sushi.
    ornith:
      displayName: Ornith
      api: openai-completions
      baseURL: http://__SERVER_IP__:8086/v1
      apiKeyEnv: SUSHI_API_KEY
      streamIdleTimeoutMs: 300000
      defaultContextWindow: 262144
      defaultMaxTokens: 32000
      compat:
        supportsDeveloperRole: true
        maxTokensField: max_tokens
      models:
        - id: Ornith-1.5-35B-A3B
          name: Ornith 1.5 35B-A3B
          input: [ text, image ]
          contextWindow: 262144
          maxTokens: 32000

    # LFM2.5-24B-A2B (Liquid AI, LFM Open License v1.0; 24B MoE, ~2B active, reasoning + tool calls) on the
    # Studio: official 8-bit MLX served by mlx_lm.server 0.32 (~/lfm-serve.sh there). No auth.
    lfm:
      displayName: LFM
      api: openai-completions
      baseURL: http://__SERVER_IP__:8087/v1
      apiKeyEnv: SPLASH_API_KEY
      streamIdleTimeoutMs: 300000
      defaultContextWindow: 131072
      defaultMaxTokens: 32768
      compat:
        supportsDeveloperRole: true
        maxTokensField: max_tokens
      models:
        - id: LiquidAI/LFM2.5-24B-A2B-MLX-8bit
          name: LFM2.5 24B-A2B
          # Text only. Liquid's sampling (temp 0.1, top_k 50) is the server default.
          contextWindow: 131072
          maxTokens: 32768

agent-default-model:
  provider: sushi
  model: Qwen3.8-Flash-Next-Sushi-3bpw
