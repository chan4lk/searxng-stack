# claude-splash / opencode-splash / pi-splash: coding agents on the Mac Studio's
# Splash models, through llama-swap (http://__SERVER_IP__:8100), which starts the
# requested model on demand. Sourced from ~/.zshrc. All three take the same
# leading arguments as claude-splash below.
#
#   claude-splash [args...]            Qwen3.8-27B Splash (the default)
#   claude-splash 3.6|3.8 [args...]    pick the Splash model
#   claude-splash --switch 3.6|3.8 ... same as above (kept for old habits; nothing restarts)
#
# The first request after the model has been idle (30 min; 2 h for 3.6) waits for
# it to load. Every model setting (main, Opus/Sonnet/Haiku defaults, subagents) is
# pointed at the same model, via a per-run copy of ~/.claude/splash-settings.json.
# MCP servers and claude.ai connectors are left out: they add ~60K prompt tokens
# and ~2 minutes to each session's first reply. Splash runs with --max-cache-disk
# 40G (SSD tier for evicted prompt caches). Key: Sushi's (~/.sushi-api-key).

typeset -gA _SPLASH_MODELS=(
  3.6 incoai/Qwen3.6-35B-A3B-Splash
  3.8 incoai/Qwen3.8-27B-Splash
)
_STUDIO_URL=http://__SERVER_IP__:8100
_SPLASH_URL=$_STUDIO_URL

_studio_key() { cat ~/.sushi-api-key 2>/dev/null; }

_splash_resolve() {  # 3.6 | 36 | full id -> full id
  local key=${1//[^0-9.]/}
  [[ $key == 36 ]] && key=3.6
  [[ $key == 38 ]] && key=3.8
  if [[ -n ${_SPLASH_MODELS[$key]} ]]; then print -r -- ${_SPLASH_MODELS[$key]}
  elif [[ $1 == incoai/* ]]; then print -r -- $1
  else return 1; fi
}

# _splash_pick NAME ARGS... — parse [--switch] [3.6|3.8] and set REPLY to the model id
# (default 3.8); sets _SPLASH_SHIFT to how many args it used. Fails if llama-swap is down.
_splash_pick() {
  local name=$1; shift
  _SPLASH_SHIFT=0
  if [[ $1 == --switch ]]; then
    REPLY=$(_splash_resolve "$2") || { print "usage: $name [--switch] 3.6|3.8 [args]" >&2; return 2; }
    _SPLASH_SHIFT=2
  elif [[ $1 != -* ]] && REPLY=$(_splash_resolve "$1" 2>/dev/null); then
    _SPLASH_SHIFT=1
  else
    REPLY=${_SPLASH_MODELS[3.8]}
  fi
  if ! curl -s -m 5 -o /dev/null -f -H "authorization: Bearer $(_studio_key)" $_STUDIO_URL/v1/models; then
    print "$name: llama-swap isn't answering at $_STUDIO_URL (on the Studio: ~/studio-stack.sh start swap; key in ~/.sushi-api-key)" >&2
    return 1
  fi
  print -u2 "$name: $REPLY (loads on first request if idle)"
}

# Qwen3.6 profile: applied when the 35B-A3B is loaded. SPLASH_PROFILE=off skips it
# (for A/B runs); SPLASH_PROFILE=force applies it to any model. The 35B is fast but
# weaker at long agentic tasks, so the profile adds:
#   - splash-proxy.py in front of Splash: preserve_thinking + Qwen coding sampling
#   - hooks: lint/syntax check after every edit; opt-in test gate on Stop
#   - qwen36-discipline.md appended to the system prompt (plan, verify, loop guard)
#   - more output room, earlier compaction, shorter tool output
_SPLASH_DIR=${0:A:h}

claude-splash() {
  _splash_pick claude-splash "$@" || return; shift $_SPLASH_SHIFT
  _claude_local claude-splash $_SPLASH_URL "$REPLY" "$(_studio_key)" 131072 splash "$@"
}

# Claude Code on vLLM (vllm-metal under llama-swap on the Studio): Qwen3.6-35B-A3B by default
# (CLAUDE_VLLM_MODEL=Qwen3.5-9B-heretic for the other), batched for many users. Same profile as
# claude-splash. Context 128K (vLLM's --max-model-len in llama-swap/config.yaml).
claude-vllm() {
  local model=${CLAUDE_VLLM_MODEL:-Qwen3.6-35B-A3B}
  if ! curl -s -m 5 -o /dev/null -f -H "authorization: Bearer $(_studio_key)" $_STUDIO_URL/v1/models; then
    print "claude-vllm: llama-swap isn't answering at $_STUDIO_URL (on the Studio: ~/studio-stack.sh start swap)" >&2
    return 1
  fi
  print -u2 "claude-vllm: $model (loads on first request if idle)"
  _claude_local claude-vllm $_STUDIO_URL "$model" "$(_studio_key)" 131072 vllm "$@"
}

# _claude_local NAME URL MODEL TOKEN CONTEXT PROXY_MODE ARGS... — run Claude Code against a
# local Anthropic-API server with every model setting pointed at MODEL.
_claude_local() {
  local name=$1 url=$2 model=$3 token=$4 ctx=$5 mode=$6; shift 6
  local settings=${TMPDIR:-/tmp}/$name-settings.$$.json
  local profile=0 proxy_pid= base=$url
  local -a extra_env extra_args
  if [[ ( $model == *Qwen3.6* && ${SPLASH_PROFILE:-on} != off ) || ${SPLASH_PROFILE:-} == force ]]; then
    profile=1
    local port=$(python3 -c 'import socket; s=socket.socket(); s.bind(("127.0.0.1",0)); print(s.getsockname()[1])')
    python3 $_SPLASH_DIR/splash-proxy.py $url $port $mode &>/dev/null &!
    proxy_pid=$!
    local i; for i in {1..50}; do curl -s -m 1 -o /dev/null http://127.0.0.1:$port/v1/models && break; sleep 0.1; done
    base=http://127.0.0.1:$port
    extra_env=(CLAUDE_CODE_MAX_OUTPUT_TOKENS=32768 CLAUDE_CODE_AUTOCOMPACT_PCT_OVERRIDE=60 BASH_MAX_OUTPUT_LENGTH=15000)
    extra_args=(--append-system-prompt-file $_SPLASH_DIR/qwen36-discipline.md)
    print -u2 "$name: Qwen3.6 profile on (proxy :$port, edit checks, verify gate, discipline prompt)"
  fi
  python3 - "$model" "$settings" "$base" "$profile" "$_SPLASH_DIR" "$token" "$ctx" <<'EOF' || { [[ -n $proxy_pid ]] && kill $proxy_pid; return 1; }
import json, os, sys
model, out, base, profile, d_, token, ctx = sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4] == "1", sys.argv[5], sys.argv[6], sys.argv[7]
d = json.load(open(os.path.expanduser('~/.claude/splash-settings.json')))
for k in ('ANTHROPIC_MODEL', 'ANTHROPIC_DEFAULT_OPUS_MODEL', 'ANTHROPIC_DEFAULT_SONNET_MODEL',
          'ANTHROPIC_DEFAULT_HAIKU_MODEL', 'CLAUDE_CODE_SUBAGENT_MODEL'):
    d['env'][k] = model
d['env']['ANTHROPIC_BASE_URL'] = base
d['env']['ANTHROPIC_AUTH_TOKEN'] = token
d['env']['CLAUDE_CODE_MAX_CONTEXT_TOKENS'] = ctx
d['model'] = model
if profile:
    d['hooks'] = {
        'PostToolUse': [{'matcher': 'Edit|Write|MultiEdit',
                         'hooks': [{'type': 'command', 'command': f'{d_}/hooks/check-edit.sh', 'timeout': 60}]}],
        'Stop': [{'hooks': [{'type': 'command', 'command': f'{d_}/hooks/verify-on-stop.sh', 'timeout': 600}]}],
    }
fd = os.open(out, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
with os.fdopen(fd, 'w') as f:
    json.dump(d, f)
EOF
  # Cache-friendly prompt: with the per-session system-prompt sections excluded,
  # a new session reuses Splash's prefix cache (~25 s -> ~4 s to first token).
  env ENABLE_CLAUDEAI_MCP_SERVERS=false CLAUDE_CODE_ATTRIBUTION_HEADER=0 \
    CLAUDE_CODE_DISABLE_GIT_INSTRUCTIONS=1 CLAUDE_CODE_DISABLE_EXPERIMENTAL_BETAS=1 $extra_env \
    claude --settings "$settings" --exclude-dynamic-system-prompt-sections \
    --strict-mcp-config --mcp-config '{"mcpServers":{}}' $extra_args "$@"
  local rc=$?
  rm -f "$settings"
  [[ -n $proxy_pid ]] && kill $proxy_pid 2>/dev/null
  return $rc
}

# OpenCode on Splash, from its own lean config (~/.config/opencode-splash):
# Splash only, no plugins (oh-my-openagent sent 80K tokens / 46 tools), no skill
# or webfetch tools. ~10K-token prompt, cached across sessions (~6 s replies).
# Sessions and auth stay shared with normal opencode (~/.local/share/opencode).
opencode-splash() {
  _splash_pick opencode-splash "$@" || return; shift $_SPLASH_SHIFT
  # OpenCode 2.x: the TUI has no -m, and the shared background service ignores
  # XDG_CONFIG_HOME, so pick the model inline and run a private server.
  XDG_CONFIG_HOME=$HOME/.config/opencode-splash \
    OPENCODE_CONFIG_CONTENT="{\"model\":\"splash/$REPLY\"}" opencode --standalone "$@"
}

# Pi on Splash (provider "splash" in ~/.pi/agent/models.json): 4 tools, ~14K prompt.
pi-splash() {
  _splash_pick pi-splash "$@" || return; shift $_SPLASH_SHIFT
  pi --model "splash/$REPLY" "$@"
}
