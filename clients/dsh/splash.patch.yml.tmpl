# Overlay: point dsh at the Splash settings file instead of ~/.dsh/settings.yaml,
# register the launch directory as a web-UI workspace, route web_search
# through a local keyless SearXNG instead of DeepSeek's paid search API, and
# add a generate_image tool backed by image-server.
# Use: dsh --profile <name> --patch ~/.dsh/splash.patch.yml
- id: settings
  config:
    path: !!js dshHomePath('splash.settings.yaml')
- insert:
    - id: cwd-workspace
      name: __HOME__/.dsh/plugins/cwd-workspace.mjs
    - id: searxng-search
      name: __HOME__/.dsh/plugins/searxng-search.mjs
      config:
        url: http://__SERVER_NAME__.__TAILNET__:8889
    - id: image-generate
      name: __HOME__/.dsh/plugins/image-generate.mjs
      config:
        url: http://__SERVER_NAME__.__TAILNET__:8890
- id: web
  config:
    searchProvider: searxng
    fetchProvider: http
- id: tool-web
  config:
    fetch: true
    searchTimeoutMs: 60000
