# Copy to install.env (git-ignored), fill in, then run ./install.sh on the
# CLIENT machine (the laptop that talks to the server over Tailscale).
# Find the values with: tailscale status   (on either machine)

# Server's Tailscale IPv4 address (tailscale ip -4, run on the server).
SERVER_IP=100.x.y.z

# Server's short MagicDNS machine name, as shown by `tailscale status`.
# Also used as the skill name and as Splash's --host bind name.
SERVER_NAME=mac-studio

# Your tailnet's MagicDNS suffix (tailscale status --json | jq -r .MagicDNSSuffix).
TAILNET=tailXXXX.ts.net

# Login user ON THE SERVER (may differ from your local username).
SERVER_USER=your-server-username

# The Tailscale account whose browser profile must approve Tailscale SSH checks.
TAILNET_ACCOUNT=you@

# One line describing the server, shown to agents in the skill.
SERVER_SPECS="Apple silicon Mac Studio"

# Splash model that clients default to; must be the one `splash serve --model` loaded.
SPLASH_MODEL=incoai/Qwen3.8-27B-Splash
